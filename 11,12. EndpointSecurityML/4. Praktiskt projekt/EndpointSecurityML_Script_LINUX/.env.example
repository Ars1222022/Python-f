# =============================================================================
# Copy this file to .env and fill in real values.
#     cp .env.example .env      (Linux/macOS)
#     Copy-Item .env.example .env   (PowerShell)
# .env is gitignored - never commit real secrets.
# =============================================================================

# --- Docker Hub (only needed for the CD workflow) ---
# Create a repository first, then paste a Personal Access Token here.
DOCKER_USERNAME=
DOCKER_PASSWORD=
DOCKER_IMAGE_PREFIX=endpointsecurityml

# --- Grafana (compose profile: monitoring) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Airflow (compose profile: airflow) ---
# Generate with:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# --- MLflow ---
# Inside Docker Compose the host is simply "mlflow"
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_SECRET_KEY=

# --- Database (PostgreSQL) ---
PGHOST=localhost
PGPORT=5432
PGUSER=airflow
PGPASSWORD=airflow
PGDATABASE=endpointsecurity

# Set to "mssql" only if you use the optional SQL Server path
DB_DIALECT=postgres
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_SERVER=localhost
MSSQL_DATABASE=EndpointSecurityML
MSSQL_TRUSTED=yes

# --- Service ports (host side) ---
POSTGRES_PORT=5432
API_PORT=8000
MLFLOW_PORT=5000
AIRFLOW_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

