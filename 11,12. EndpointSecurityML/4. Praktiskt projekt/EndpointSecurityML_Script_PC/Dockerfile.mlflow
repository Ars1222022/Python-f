# =============================================================================
# MLflow tracking server
# Uses `mlflow server` (mlflow ui is deprecated) with an absolute SQLite path
# =============================================================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MLFLOW_DATA_DIR=/mlflow

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
        mlflow==2.12.2 \
        SQLAlchemy==2.0.40 \
        psycopg[binary]==3.2.9 \
    && mkdir -p /mlflow/artifacts

VOLUME ["/mlflow"]
EXPOSE 5000

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=10 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/health', timeout=3)" || exit 1

# NOTE: the real command is supplied by docker-compose.yml
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
     "--serve-artifacts", "--artifacts-destination", "/mlflow/artifacts"]
